# 运行环境与端口：本地开发、docker-compose 构建都以本文件为准。
# 真实部署注入的同名环境变量优先级最高，会覆盖这里的值。
APP_ENV=local
APP_NAME=特种设备点检运维平台

# 后端监听地址：本机用 127.0.0.1；容器内由 docker-compose 覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=8000

# 前端 dev server 端口；后端 CORS 默认按此端口放行。
FRONTEND_PORT=5173

# 跨域来源留空时自动放行 http://127.0.0.1:${FRONTEND_PORT}；
# 多来源用逗号分隔，例如 http://127.0.0.1:5173,https://ops.example.com
CORS_ALLOW_ORIGINS=
