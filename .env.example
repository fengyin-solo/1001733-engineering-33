# ===== 运行环境（这份配置是端口与环境变量的唯一准星）=====
# 复制为 .env 后按需修改；docker compose 会自动读取根目录 .env
APP_ENV=local
APP_NAME=特种设备点检运维平台

# ===== 后端 =====
# 本地默认只监听回环；容器部署时用 APP_HOST=0.0.0.0 覆盖
APP_HOST=127.0.0.1
APP_PORT=8000
# 示例数据文件（本地与镜像用同一份 backend/data/seed.json）
APP_SEED_FILE=data/seed.json
# 启动时是否做基础数据自检与幂等装载
APP_SEED_ON_STARTUP=true
# 允许的前端来源，多个用逗号分隔
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== 前端 dev server =====
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
# /api 代理目标；容器部署指向 http://backend:8000
VITE_PROXY_TARGET=http://127.0.0.1:8000
# 前端拼链接用的 API 基址，留空走同源代理
VITE_API_BASE=
VITE_APP_NAME=特种设备点检运维平台
